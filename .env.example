# Copy this file to .env and fill in the values. .env is git-ignored.

# --- Required for the web application ------------------------------------------
# PostgreSQL connection URL (SQLAlchemy format, psycopg v3 driver).
DATABASE_URL=postgresql+psycopg://concordance:change-me@localhost:5432/concordance

# Secret used to sign session tokens (JWT). At least 16 characters.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=

# --- Required to analyse documents ----------------------------------------------
# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Optional -------------------------------------------------------------------
# Model used for page classification (L3) and extraction (L5).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Session lifetime in minutes (default 480).
# TOKEN_MINUTES=480

# Where analysis artifacts and uploads are written (default: ./data).
# CONCORDANCE_DATA_DIR=

# Set to 0 to disable the semantic veto in the comparison engine (L8).
# It only runs when the optional "semantic" extra is installed.
# CONCORDANCE_SEMANTIC_VETO=1

# Windows only: folder holding the Pango/GTK DLLs required by WeasyPrint
# (MSYS2 default is detected automatically).
# WEASYPRINT_DLL_DIR=C:\msys64\mingw64\bin
